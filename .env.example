# Credenciales locales de BetBot — copia este fichero a `.env` y rellena SOLO
# las que uses. `.env` esta en .gitignore: nunca se commitea, nunca se imprime.
# La variable exportada en la shell siempre tiene precedencia sobre `.env`.

# The Odds API (cuotas moneyline multioperador; plan gratuito)
BETBOT_ODDS_API_KEY=

# Sportradar Tennis v3 (calendario+resultados oficiales; trial gratuito) — opcional
SPORTRADAR_API_KEY=

# Betfair Exchange solo-lectura (mercados de sets) — opcional
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=

# Odds-API.io (solo el sondeo feeds oddsapiio-probe) — opcional
ODDS_API_IO_KEY=
